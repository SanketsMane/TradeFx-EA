// TradeFx — Expert Advisor trading platform schema.
//
// Two halves. The execution engine (Account / CopierConfig / Subscription /
// CopyEvent) is internal plumbing: one master account running an Expert
// Advisor, fanned out to client accounts. The commercial side (BotLicense /
// QuoteRequest / BrokerOffer) is what a customer sees.
//
// Naming note: the engine tables keep their original names. Customer-facing
// text must never use them — the product is an Expert Advisor, not a copier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  /// Self-registered client. Sees only their own licences and accounts.
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

/// Singleton row (id = "singleton") holding platform-wide config.
model PlatformSetting {
  id                    String  @id @default("singleton")
  metaapiTokenEncrypted String?
  metaapiRegion         String  @default("new-york")

  // ---- Email / SMTP (app password encrypted at rest) ----
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean   @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  smtpFromName          String?
  smtpFromEmail         String?
  alertEmail            String?
  alertsEnabled         Boolean   @default(true)
  smtpUpdatedAt         DateTime?

  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role
  status       UserStatus @default(ACTIVE)

  // Collected at self-registration; staff accounts leave them null.
  fullName String?
  /// Also a sign-in identity (OTP), so it must be unique. Null for staff.
  phone    String? @unique

  hashedRefreshToken String?

  // Self-service password reset (forgot-password): argon2 hash of a one-time token.
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?

  createdById  String?
  createdBy    User?   @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreator")

  auditLogs       AuditLog[]
  notifications   Notification[]
  createdAccounts Account[]      @relation("AccountCreator")
  createdCopiers  CopierConfig[] @relation("CopierCreator")
  sessions        Session[]

  // Customer side
  ownedAccounts  Account[]      @relation("AccountOwner")
  licenses       BotLicense[]
  quoteRequests  QuoteRequest[] @relation("QuoteRequester")
  quotesAnswered QuoteRequest[] @relation("QuoteResponder")
  licensesIssued BotLicense[]   @relation("LicenseIssuer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// One row per signed-in device/session (refresh-token backed).
model Session {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken String
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  revokedAt   DateTime?

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  meta       Json?
  ts         DateTime @default(now())

  @@index([userId, ts])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Accounts + Copier
// ---------------------------------------------------------------------------

enum Platform {
  MT4
  MT5
}

enum AccountStatus {
  PROVISIONING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum SizingMode {
  FIXED_LOT
  MULTIPLIER
  BALANCE_RATIO
}

enum ReceiverStatus {
  ACTIVE
  PAUSED
  ERROR
}

/// A connected MetaTrader account. Can be a source and/or a receiver via copier configs.
model Account {
  id                String        @id @default(uuid())
  label             String
  metaapiAccountId  String
  login             String
  server            String
  platform          Platform
  encryptedPassword String
  status            AccountStatus @default(PROVISIONING)
  /// Broker position-accounting mode, captured from MetaApi: 'netting' | 'hedging' | null.
  marginMode        String?

  /// Deposit currency as the broker reports it — client figures are shown in it.
  currency String @default("USD")

  createdById String
  createdBy   User   @relation("AccountCreator", fields: [createdById], references: [id])

  /// The customer this account belongs to. Null for master/house accounts.
  ownerId String?
  owner   User?       @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  license BotLicense? @relation("LicenseAccount")

  sourceForConfig       CopierConfig?  @relation("ConfigSource")
  receiverSubscriptions Subscription[] @relation("ReceiverAccount")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete: non-null = removed (recoverable)

  @@index([deletedAt])
  @@index([ownerId])
  @@map("accounts")
}

/// A copier: one SOURCE account that many RECEIVER accounts copy from.
/// Maps to a CopyFactory strategy created for the source account.
model CopierConfig {
  id                    String  @id @default(uuid())
  name                  String
  /// Catalogue slug this master runs, e.g. "scalper". Set it and customer
  /// licences for that product attach their accounts here automatically.
  productSlug           String? @unique
  sourceAccountId       String  @unique
  sourceAccount         Account @relation("ConfigSource", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  copyfactoryStrategyId String
  enabled               Boolean @default(true)

  createdById String
  createdBy   User   @relation("CopierCreator", fields: [createdById], references: [id])

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("copier_configs")
}

/// A receiver in a copier config (maps to a CopyFactory subscriber + subscription).
model Subscription {
  id                      String       @id @default(uuid())
  copierConfigId          String
  copierConfig            CopierConfig @relation(fields: [copierConfigId], references: [id], onDelete: Cascade)
  receiverAccountId       String
  receiverAccount         Account      @relation("ReceiverAccount", fields: [receiverAccountId], references: [id], onDelete: Cascade)
  copyfactorySubscriberId String

  sizingMode    SizingMode     @default(MULTIPLIER)
  multiplier    Decimal        @default(1)
  copySl        Boolean        @default(true)
  copyTp        Boolean        @default(true)
  reverse       Boolean        @default(false)
  symbolMapping Json?
  enabled       Boolean        @default(true)
  status        ReceiverStatus @default(ACTIVE)

  // Trade filters (mapped to CopyFactory subscription fields).
  symbolFilterMode SymbolFilterMode @default(NONE)
  symbolFilterList String[]         @default([])
  minVolume        Float?
  maxVolume        Float?

  // Trading-hours window (minutes-of-day in UTC, 0–1439). When both are set the
  // receiver only opens new copied trades inside the window (a scheduler pauses
  // it outside). Null = copy 24h.
  tradeWindowStart Int?
  tradeWindowEnd   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([copierConfigId, receiverAccountId])
  @@index([copierConfigId])
  @@map("subscriptions")
}

enum SymbolFilterMode {
  NONE
  INCLUDE // only copy symbols in the list
  EXCLUDE // copy everything except symbols in the list
}

// ---------------------------------------------------------------------------
// Monitoring (plain id columns — history survives account/config deletion)
// ---------------------------------------------------------------------------

enum Side {
  BUY
  SELL
}

enum CopyAction {
  OPEN
  CLOSE
  MODIFY
}

enum CopyStatus {
  SUCCESS
  FAILED
  FILTERED
}

model CopyEvent {
  id                String     @id @default(uuid())
  externalId        String?    @unique
  copierConfigId    String?
  sourceAccountId   String
  receiverAccountId String
  sourceTicket      String
  receiverTicket    String?
  symbol            String
  side              Side
  lots              Decimal
  sl                Decimal?
  tp                Decimal?
  action            CopyAction
  status            CopyStatus @default(SUCCESS)
  latencyMs         Int?
  pnl               Decimal?
  ts                DateTime   @default(now())

  @@index([sourceAccountId, ts])
  @@index([receiverAccountId, ts])
  @@index([copierConfigId, ts])
  @@map("copy_events")
}

model AccountSnapshot {
  id            String   @id @default(uuid())
  accountId     String
  balance       Decimal
  equity        Decimal
  margin        Decimal  @default(0)
  openPositions Int      @default(0)
  ts            DateTime @default(now())

  @@index([accountId, ts])
  @@map("account_snapshots")
}

enum NotificationType {
  COPY_FAILED
  ACCOUNT_OFFLINE
  ACCOUNT_ONLINE
  INFO
}

/// In-app notification for a user (bell feed). Complements outbound email alerts.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(INFO)
  title     String
  body      String?
  meta      Json?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Commerce — what the customer buys and sees
// ---------------------------------------------------------------------------

enum LicenseStatus {
  /// Issued and paid for, but not yet bound to a trading account.
  UNASSIGNED
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

/// Entitlement to run one Expert Advisor on one trading account.
///
/// `code` is the 9-character string the customer types when linking an
/// account. It is generated from a Crockford-style alphabet (no I, L, O, U,
/// no 0/1) so codes read aloud or copied off a screen cannot be garbled.
model BotLicense {
  id     String @id @default(uuid())
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Catalogue slug, e.g. "scalper". The product list lives in code, not the DB.
  productSlug String
  /// Name captured at issue time, so renaming a product never rewrites history.
  productName String

  status LicenseStatus @default(UNASSIGNED)

  /// The account this licence runs on — one licence, one account.
  linkedAccountId String?  @unique
  linkedAccount   Account? @relation("LicenseAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)
  /// The receiver subscription that actually executes for this licence.
  subscriptionId  String?  @unique

  issuedById  String?
  issuedBy    User?     @relation("LicenseIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  issuedAt    DateTime  @default(now())
  activatedAt DateTime?
  /// Null means perpetual.
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@map("bot_licenses")
}

enum QuoteStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
}

/// A request for a price. Prices are never shown in the UI — an advisor reads
/// the request and replies out of band, then records the outcome here.
model QuoteRequest {
  id        String @id @default(uuid())
  /// Short human reference quoted back to the customer, e.g. "TFX-4821".
  reference String @unique

  /// Set when the requester was signed in; anonymous enquiries leave it null.
  userId String?
  user   User?   @relation("QuoteRequester", fields: [userId], references: [id], onDelete: SetNull)

  name  String
  email String
  phone String?

  /// Exactly one of these is set — a catalogue product or a service.
  productSlug String?
  serviceSlug String?

  broker      String?
  accountSize String?
  message     String

  status     QuoteStatus @default(NEW)
  /// What the advisor told the customer. Never a machine-readable price: the
  /// figure itself is sent by email, so nothing renders a price in the UI.
  quotedNote String?
  quotedAt   DateTime?
  quotedById String?
  quotedBy   User?       @relation("QuoteResponder", fields: [quotedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("quote_requests")
}

/// A broker we refer clients to. `signupUrl` carries our affiliate parameters.
model BrokerOffer {
  id         String   @id @default(uuid())
  name       String
  logo       String?
  blurb      String
  signupUrl  String
  highlights String[] @default([])
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("broker_offers")
}

/// A one-time code sent to a mobile number.
///
/// The code is stored only as an argon2 hash — a leaked database must not
/// hand over live codes. Challenges are single-use, expire quickly, and cap
/// the number of guesses.
model OtpChallenge {
  id         String    @id @default(uuid())
  /// Normalised national number (digits only), matching what the SMS gateway wants.
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  /// Kept for abuse investigation, not for rate limiting (that is in-request).
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}
