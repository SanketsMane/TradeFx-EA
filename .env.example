# ---- Database ----
DATABASE_URL="postgresql://tcp:tcp_dev_password@localhost:5433/trade_copier?schema=public"

# ---- API ----
API_PORT=3000
NODE_ENV=development

# Comma-separated allowed CORS origins (prod). Empty = reflect any origin (dev only).
CORS_ORIGINS=""

# ---- Auth ----
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ---- Super Admin seed (hashed on first boot; plaintext never stored) ----
SUPER_ADMIN_EMAIL="contactsanket1@gmail.com"
SUPER_ADMIN_PASSWORD="set-a-strong-password-here"

# ---- Credential encryption (AES-256-GCM key for stored broker passwords) ----
CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-32+char-random-secret"

# ---- Account limits (per tenant) ----
MAX_ACCOUNTS=50
MAX_COPIERS=2
MAX_RECEIVERS_PER_COPIER=10

# ---- MetaApi (platform token; empty = use mock copier provider) ----
METAAPI_TOKEN=""
METAAPI_REGION="new-york"

# ---- Email / SMTP (fallback only; prefer configuring in Settings → Email/SMTP) ----
# App password is stored encrypted when set via the UI. These env vars are used
# only when nothing is saved in Settings. For Gmail use an app password.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=""                 # sender / auth email, e.g. you@gmail.com
SMTP_PASSWORD=""             # SMTP or Gmail app password
SMTP_FROM_NAME="TradeFx"
SMTP_FROM_EMAIL=""           # optional; defaults to SMTP_USER
ALERT_EMAIL=""               # where copy alerts go; empty = notify all super-admins
ALERTS_ENABLED="true"

# ---- App URL (used in email links, e.g. the "Sign in" button) ----
APP_URL="http://localhost:5173"

# --- Partner broker referral (customer portal) -----------------------------
# The affiliate link customers open their trading account through. Leave blank
# and the portal's broker page stays empty rather than pointing somewhere wrong.
BROKER_AFFILIATE_URL=
BROKER_AFFILIATE_NAME=Partner Broker

# --- SMS gateway (sms.renflair.in) — mobile OTP sign-in ------------------
# Server-side only; never expose to the browser. India-only, 10-digit numbers.
# Unset in development, verification codes are printed to the server log
# instead of being sent. Unset in production, mobile sign-in is refused.
SMS_API_KEY=
